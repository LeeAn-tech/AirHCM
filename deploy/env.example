# Sao chép thành backend\.env rồi điền giá trị. KHÔNG đưa tệp .env thật lên Git hoặc gửi kèm bài nộp.
# Kết nối PostgreSQL/PostGIS (bắt buộc)
DATABASE_URL=postgresql://postgres:MAT_KHAU@localhost:5432/webgis_aqi_hcm

# Khóa ký token đăng nhập (để trống thì tự sinh)
AUTH_SECRET=

# Trợ lý AI Gemini + embedding RAG (không bắt buộc)
GEMINI_API_KEY=

# Gmail gửi email cảnh báo (không bắt buộc) - dùng App Password của Gmail
SMTP_SENDER_EMAIL=
SMTP_APP_PASSWORD=

# Phân hệ AirData
AIRDATA_REALTIME=1          # 0 = tắt cập nhật dữ liệu mỗi giờ
AIRDATA_GEE=0               # 1 = dùng Google Earth Engine (cần earthengine authenticate)
# AIRDATA_GEE_PROJECT=      # mã dự án Google Cloud có bật Earth Engine
