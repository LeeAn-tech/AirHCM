# =====================================================================
# Mẫu file backend/.env cho MÁY CHỦ CLOUD (Azure VM)
# Cách dùng: sao chép thành backend/.env trên máy chủ rồi điền giá trị thật.
# KHÔNG đưa file .env thật lên GitHub (đã có trong .gitignore).
# Mật khẩu CSDL nên chỉ gồm chữ + số (tránh @ : / ? # % vì phải mã hóa trong URL).
# =====================================================================

# --- CSDL Azure Database for PostgreSQL (bắt buộc SSL) ---
DATABASE_URL=postgresql://airhcmadmin:DIEN_MAT_KHAU@DIEN_TEN_SERVER.postgres.database.azure.com:5432/webgis_aqi_hcm?sslmode=require
# Gói B1MS cho tối đa ~50 kết nối: giữ pool nhỏ
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Sao chép nguyên các dòng đang dùng trong backend/.env ở máy Windows ---
SMTP_SENDER_EMAIL=
SMTP_APP_PASSWORD=
AUTH_SECRET=
GEMINI_API_KEY=
FIREBASE_PROJECT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Lịch chạy realtime (phút) ---
ALERT_INTERVAL_MINUTES=30
ETL_INTERVAL_MINUTES=30
ETL_ON_STARTUP=1
FCM_ENABLED=1

# --- AirData: dự báo realtime 7 ngày + các tháng tới ---
AIRDATA_REALTIME=1
AIRDATA_ON_STARTUP=1
AIRDATA_MONTHLY_OUTLOOK=3
# Earth Engine trên máy chủ dùng tài khoản dịch vụ (service account)
AIRDATA_GEE=1
AIRDATA_GEE_PROJECT=master-magnet-470812-h1
AIRDATA_GEE_SERVICE_ACCOUNT=DIEN_TEN@master-magnet-470812-h1.iam.gserviceaccount.com
AIRDATA_GEE_KEY_FILE=/home/azureuser/AirHCM/backend/gee-key.json
